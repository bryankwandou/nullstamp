/// z-tenant-nullstamp WIT world — verifiable consent receipts for agent calls.
///
/// Nullstamp issues a receipt for every third-party call that touches a person's
/// data. The receipt names which fields were referenced, which host received
/// them, and what came back — without ever holding the field values.
///
/// Host capabilities used:
///   - tenant-context:         tenant DID, contract id, calling user DID,
///                             cluster timestamp, sequence number
///   - logging:                execution trace, never carrying PII
///   - kv-store:               receipt storage, plus set-claims-digest, which
///                             plants the digest in the transaction's Merkle leaf
///                             so a receipt can be verified outside the node
///   - http-with-placeholders: outbound calls carrying `{{profile.<field>}}`
///                             markers. The host substitutes them inside the
///                             enclave, so plaintext never enters WASM memory.
///
/// `host:interfaces/signing@2.1.0` is deliberately NOT imported.
///
/// Version 0.1.0 did import it, and the contract could not be instantiated at
/// all: every call answered "Internal error" HTTP 500 with not one line reaching
/// the contract log, including calls to functions that never touch signing. The
/// interface is declared in host-interfaces-2.1.0 at line 159, but it appears not
/// to be granted to tenant contracts, and the official reference repo does not
/// import it either. See finding T-12 in docs/BUGS.md.
///
/// Receipt integrity does not depend on it. The digest is anchored through
/// `kv-store.set-claims-digest` into the transaction's Merkle leaf, and that is
/// what verification outside the node rests on.
///
/// Plain `host:interfaces/http` is not imported either, and that one is purely a
/// design choice: Nullstamp's only way out is http-with-placeholders, so no path
/// inside this contract can send data without passing through host-side marker
/// substitution.
package z:tenant-nullstamp@0.1.7;

world tenant-nullstamp {
    import host:tenant/tenant-context@1.0.0;
    import host:interfaces/logging@2.1.0;
    import host:interfaces/kv-store@2.1.0;
    import host:interfaces/http-with-placeholders@2.1.0;

    export contracts;
}

interface contracts {
    /// The standard three-field envelope used by every contract the node calls.
    /// `input`        — JSON payload specific to the function.
    /// `user-profile` — always None for tenant contracts.
    /// `context`      — node-minted DynamicContext JSON.
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    /// Perform one outbound call using profile markers, then issue a receipt
    /// covering that call.
    ///
    /// Input (JSON):
    /// {
    ///   "purpose":        "flight_booking",
    ///   "method":         "POST",
    ///   "url":            "https://api.duffel.com/air/orders",
    ///   "headers":        [["Accept","application/json"]],
    ///   "declared_fields":["first_name","last_name"],
    ///   "body_template":  { "given_name": "{{profile.first_name}}" },
    ///   "secret_key":     "duffel_api_key"
    /// }
    ///
    /// `declared_fields` must match the profile markers appearing in
    /// `body_template` exactly. Any discrepancy is rejected before a single byte
    /// goes out, so a receipt cannot claim less than what was actually used.
    ///
    /// Output (JSON): the full receipt with its digest and signature slot.
    issue-receipt: func(req: generic-input) -> result<list<u8>, string>;

    /// Recompute a stored receipt's digest and compare it against the digest
    /// recorded at issuance.
    ///
    /// Input  (JSON): { "receipt_id": "rcpt_..." }
    /// Output (JSON): { "valid": bool, "receipt_id": string, "digest": string,
    ///                  "reason": option<string> }
    verify-receipt: func(req: generic-input) -> result<list<u8>, string>;

    /// Read this tenant's receipt trail, ascending by receipt id.
    ///
    /// Input  (JSON): { "start": option<string>, "limit": u32 }
    /// Output (JSON): { "receipts": [...], "count": u32 }
    list-receipts: func(req: generic-input) -> result<list<u8>, string>;
}
