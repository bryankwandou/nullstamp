# Salin berkas ini menjadi .env lalu isi nilainya.
# Jangan pernah menyertakan .env ke dalam riwayat repositori.

# Kunci pengembang dari halaman klaim. Hanya ditampilkan satu kali dan tidak
# bisa diambil ulang selama fase pengujian, jadi salin segera saat muncul.
#   https://go.terminal3.io/adk-community
T3N_API_KEY=

# Lingkungan yang dituju: testnet, sandbox, atau production.
T3N_ENV=testnet

# Nama pendek contract. Nama kanoniknya menjadi z:<tid>:nullstamp
NULLSTAMP_TAIL=nullstamp

# Naikkan setiap kali WASM didaftarkan ulang. Node menolak pendaftaran dengan
# versi yang tidak lebih tinggi dari yang sudah tercatat.
NULLSTAMP_VERSION=0.1.0

# Tujuan panggilan keluar untuk peragaan. Layanan gema dipakai sebagai bawaan
# karena tanggapannya memperlihatkan langsung bahwa marker profil diselesaikan
# di sisi host.
NULLSTAMP_TARGET_URL=https://postman-echo.com/post

# Field profil yang dirujuk peragaan, dipisah tanda koma.
NULLSTAMP_FIELDS=first_name,last_name

# Kredensial upstream yang ditanam ke map secrets. Kosongkan bila peragaan
# tidak memerlukan kredensial.
NULLSTAMP_SECRET_KEY=upstream_api_key
NULLSTAMP_SECRET_VALUE=

# Setel 1 bila contract harus memasang kredensial itu pada panggilan keluarnya.
NULLSTAMP_USE_SECRET=0

# Jangan disetel kecuali manifest operator memang belum tersedia untuk
# lingkungan yang dituju. Nilai 1 melewati verifikasi attestation.
T3N_UNSAFE_TRUST_SERVER=0
